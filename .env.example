# ── Оплата (WayForPay) ──────────────────────────────────────────────
# Прямі платіжні посилання на кожен пакет (кабінет → Платіжні кнопки → «Посилання»).
# Поки не задані — кнопки ведуть на секцію тарифів (#tariffs).
NEXT_PUBLIC_PAY_LINK_STANDARD=
NEXT_PUBLIC_PAY_LINK_CHAT=
NEXT_PUBLIC_PAY_LINK_PERSONAL=

# ── Telegram ────────────────────────────────────────────────────────
# Канал для тарифу «Стандарт»:
NEXT_PUBLIC_TELEGRAM_URL_STANDARD=https://t.me/+GOuTJufFE8g0MTVi
# Спільний канал для тарифів «Чат з учасницями» і «Персональний супровід»:
NEXT_PUBLIC_TELEGRAM_URL_PREMIUM=https://t.me/+NNvTmwwDb1YzZmNi
# /thank-you?plan=standard|chat|personal обирає канал автоматично.
# ВАЖЛИВО: в обох каналах увімкніть «Заявки на вступ» (join requests).

# ── Google Analytics (GA4) ──────────────────────────────────────────
# Measurement ID виду G-XXXXXXXXXX. Скрипти GA монтуються ЛИШЕ після згоди
# «Прийняти всі» у cookie-банері. Якщо GA_ID заданий — банер вмикається автоматично.
NEXT_PUBLIC_GA_ID=

# ── Cookie-банер ────────────────────────────────────────────────────
# true — показувати банер завжди; false — лише коли заданий NEXT_PUBLIC_GA_ID.
NEXT_PUBLIC_SHOW_COOKIE_BANNER=false
