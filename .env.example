# ─────────────────────────────────────────────────────────────────────
# УВАГА про префікси.
#   NEXT_PUBLIC_*  — вшивається в клієнтський бандл на етапі збірки
#                    і видно будь-кому у вихідному коді сторінки.
#   решта          — читається лише serverless-функціями в рантаймі.
# Секрети (ключі, токени) НІКОЛИ не мають префікса NEXT_PUBLIC_.
# Після зміни NEXT_PUBLIC_* потрібен ребілд; серверні підхоплюються без нього.
#
# Локально це файл .env (його читає `netlify dev`), він у .gitignore.
# На проді — панель Netlify → Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────────────

# ── WayForPay ───────────────────────────────────────────────────────
# Кабінет мерчанта. merchantSecretKey — саме СЕКРЕТНИЙ ключ, ним
# підписується і платіж, і перевірка вебхука.
WFP_MERCHANT_ACCOUNT=
WFP_MERCHANT_SECRET=
WFP_MERCHANT_DOMAIN=marinek.store
# Валюта й ціни мають збігатися з налаштуваннями мерчант-акаунта
# (ціни — в netlify/lib/plans.ts).
WFP_CURRENCY=USD

# Базова адреса для serviceUrl/returnUrl. Локально — адреса тунеля,
# бо WayForPay не достукається до localhost. На проді не задавати:
# функція візьме origin запиту.
# PUBLIC_SITE_URL=https://<щось>.trycloudflare.com

# ── Telegram ────────────────────────────────────────────────────────
# Бот має бути адміністратором обох каналів з правом запрошувати
# користувачів за посиланням. ID каналів — вигляду -100…
TELEGRAM_BOT_TOKEN=
TG_CHANNEL_STANDARD_ID=
TG_CHANNEL_PREMIUM_ID=

# ── Supabase ────────────────────────────────────────────────────────
# service_role обходить RLS — тільки для функцій, ніколи не на клієнт.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Для сторінки /admin — вона працює прямо з браузера. Ці два значення
# публічні за задумом: сам по собі ключ нічого не відкриває, доступ до
# рядків вирішує RLS + вхід через Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Оновлення сайту з кабінету ──────────────────────────────────────
# Netlify → Site configuration → Build & deploy → Build hooks. Адреса
# виду https://api.netlify.com/build_hooks/<id> — це і Є право запустити
# збірку, тому вона без NEXT_PUBLIC_ і живе тільки у функції publish-site.
NETLIFY_BUILD_HOOK_URL=

# ── Пошта (Resend) ──────────────────────────────────────────────────
# Дублює інвайт листом: якщо вкладку /thank-you закрили, посилання
# лишається в пошті. Домен має бути підтверджений у Resend.
RESEND_API_KEY=
# Людська адреса замість no-reply@ і reply_to на живу пошту:
# краще проходить спам-фільтри, і клієнтка може просто відповісти.
RESEND_FROM=Marina K <marina@marinek.store>
RESEND_REPLY_TO=<owner-inbox@example.com>

# ── Google Analytics (GA4) ──────────────────────────────────────────
# Measurement ID виду G-XXXXXXXXXX. Скрипти GA монтуються ЛИШЕ після згоди
# «Прийняти всі» у cookie-банері. Якщо GA_ID заданий — банер вмикається автоматично.
NEXT_PUBLIC_GA_ID=

# ── Cookie-банер ────────────────────────────────────────────────────
# true — показувати банер завжди; false — лише коли заданий NEXT_PUBLIC_GA_ID.
NEXT_PUBLIC_SHOW_COOKIE_BANNER=false
