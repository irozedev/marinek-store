# ── Оплата (WayForPay) ──────────────────────────────────────────────
# Прямі платіжні посилання на кожен пакет. Взяти з кабінету WayForPay.
# Поки не задані — кнопки ведуть на секцію тарифів (#tariffs).
NEXT_PUBLIC_PAY_LINK_STANDARD=
NEXT_PUBLIC_PAY_LINK_CHAT=
NEXT_PUBLIC_PAY_LINK_PERSONAL=

# ── Telegram ────────────────────────────────────────────────────────
# Посилання на бот/канал, куди потрапляє учасниця після оплати
# (сторінка /thank-you робить авторедірект сюди через ~3.5 с).
NEXT_PUBLIC_TELEGRAM_URL=

# ── Google Analytics (GA4) ──────────────────────────────────────────
# Measurement ID виду G-XXXXXXXXXX. Взяти в Google Analytics → Admin →
# Data Streams. Скрипти GA монтуються ЛИШЕ після згоди «Прийняти всі»
# у cookie-банері. Якщо GA_ID заданий — банер вмикається автоматично.
NEXT_PUBLIC_GA_ID=

# ── Cookie-банер ────────────────────────────────────────────────────
# true — показувати банер завжди; false — лише коли заданий NEXT_PUBLIC_GA_ID.
# Без аналітики сайт не збирає даних, тому банер не обов'язковий.
NEXT_PUBLIC_SHOW_COOKIE_BANNER=false
